# Copy this file to .env.local and fill in your values.
# Both URLs come from the Neon dashboard for your project.

# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.us-east-1.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require"
